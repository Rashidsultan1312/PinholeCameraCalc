"formula.rayleigh.title" = "Diametro ottimale di Rayleigh";
"formula.rayleigh.body" = "d = √(2.44 · λ · f). Per λ = 550 nm e f in mm:  d ≈ 0.0366 · √f.";
"formula.fstop.title" = "Numero F equivalente";
"formula.fstop.body" = "N = f / d. Una pinhole 100 mm con foro 0.366 mm ha apertura ≈ f/273.";
"formula.sunny16.title" = "Sunny 16";
"formula.sunny16.body" = "t = 1 / (ISO · N² / 256). Punto di partenza con cielo sereno; raddoppia con velato, x4 con nuvole, x8 con coperto.";
"formula.schwarzschild.title" = "Correzione di Schwarzschild";
"formula.schwarzschild.body" = "Sopra il secondo, tempo reale = tempo misurato^(1/p). p tipico: HP5 0.78, Tri-X 0.85, Fomapan 0.70, Velvia 50 0.65.";

"theory.history.title" = "Mille anni di camera oscura";
"theory.history.body" = "Già Mozi nel V secolo a.C. descrive una stanza buia con un foro. Da Alhazen al Rinascimento, la pinhole è il padre della fotografia.";
"theory.diffraction.title" = "Diffrazione";
"theory.diffraction.body" = "Sotto il diametro di Rayleigh l'immagine si ammorbidisce per diffrazione. Sopra, si ammorbidisce per geometria. Esiste un solo punto ottimo per ogni focale.";
"theory.image.title" = "Inversione dell'immagine";
"theory.image.body" = "I raggi luminosi si incrociano nel foro, l'immagine appare capovolta e ribaltata sul piano della pellicola.";
"theory.depth.title" = "Profondità di campo infinita";
"theory.depth.body" = "Con foro così piccolo, l'apertura è chiusa a f/200 o più: tutto è a fuoco dal foro all'infinito.";

